# ↓ 这里原有一行照搬自官方基座的 CONFIG_PACKAGE_kmod-nft-fullcone=y，
#   2026-09-15 首次构建被第 9 步自检拦下后移除。原因与证据见文件头
#   「剔除的作者配置项」最后一条 —— 本 fork 没有 fullconenat-nft 这个包，
#   写了也是未知符号，make defconfig 会静默丢弃。

#
# ══ §11 NAT / UPnP ════════════════════════════════════════════════════
#
# UPnP 有两个后端变体：miniupnpd-iptables / miniupnpd-nftables。
# 24.10 用的是 firewall4（nftables），必须显式指定 nftables 变体。
# 不指定的话，LuCI 上装出来的是哪个后端取决于变体的默认优先级，容易踩坑。
#
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y

#
# ══ §12 内存与运维 ════════════════════════════════════════════════════
#
# zram-swap：用压缩内存做交换区，比闪存交换快得多，也不磨损 NAND。
# 本机 MemTotal 230316 kB、空载 MemAvailable 仅 42640 kB，zram 交换区
# 112 MiB 已用 37.8% —— 这是本次升级的主要理由，也是必须留着它的原因。
#
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_openssh-keygen=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_blockd=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_libipset=y
CONFIG_PACKAGE_ebtables=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tc-tiny=y

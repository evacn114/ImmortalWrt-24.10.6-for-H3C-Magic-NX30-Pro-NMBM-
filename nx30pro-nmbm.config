#
# ImmortalWrt 24.10.6 / H3C Magic NX30 Pro (NMBM layout)
# 用途：GitHub Actions 自编译配置
#
# ── 本文件的每个符号都经过外部权威清单校验，不是凭记忆写的 ─────────────
# 校验基准：官方发布产物 downloads.immortalwrt.org/releases/24.10.6/
#   · config.buildinfo                          → 设备符号的精确拼写
#   · packages/aarch64_cortex-a53/*/Packages.gz → 用户态包是否存在
#   · targets/mediatek/filogic/kmods/<vermagic>/Packages.gz → 内核模块是否存在
# 校验结果：32 个显式包全部存在（含后加入的 zerotier / luci-app-zerotier /
#           luci-i18n-zerotier-zh-cn），依赖闭包无缺失。
#
# ── 两条硬约束（决定了本文件为什么要写成这样）──────────────────────────
# 1) 内核模块无法事后安装。vermagic = md5(内核配置里所有 =y/=m 行排序后)，
#    自编译的内核配置必然与官方不同 → vermagic 不同 → 官方 kmods 源里的包
#    依赖 kernel (=6.6.133~<官方vermagic>-r1)，opkg 会直接拒绝安装。
#    所以凡是「将来可能要用」的内核模块，现在就得编进去。
# 2) 用户态包可以事后安装。它们不依赖 vermagic，且本方案与官方用的是同一批
#    feed 提交，版本号一致，opkg 装得上。
#
# ── 前置条件（已用实机输出核对，2026-09-13）────────────────────────
# · 实机 cat /proc/mtd：九段分区与 24.10 NMBM DTS 逐字段一致，
#   ubi 位于 0x580000、长 0x4000000（64 MiB），erasesize 0x20000（128 KiB）。
#   ⇒ 分区布局无需变更，U-Boot 不需要动。
# · 实机 board_name 为 h3c,nx30pro，目标板名为 h3c,magic-nx30-pro-nmbm。
#   ⇒ 板名不同，须经由 U-Boot failsafe webui 刷 factory.bin；
#     不要用系统内 sysupgrade，会因设备名不符被直接拒绝。
# · 实机内存：MemTotal 230316 kB、MemAvailable 42640 kB，
#   zram 交换区 112 MiB 已用 42.4 MiB（37.8%），空载即持续换页。
#   ⇒ 这是本次升级的主要理由；关闭 passwall 冗余组件主要为省内存。
#
# 说明：本文件只写「有意指定」的符号，其余由 make defconfig 自动补全。
#
# ⚠ 有一类包**不体现在任何依赖里**，却一定会进固件：target 的 Default-Packages。
#   机制：scripts/target-metadata.pl 让设备符号 select DEFAULT_<包名>，而
#   scripts/package-metadata.pl 给每个包生成 `default y if DEFAULT_<包名>`，
#   于是 make defconfig 之后这些包一律 =y。任何 INCLUDE_* 开关都管不到它们。
#   官方 profiles.json 的 default_packages 共 42 项，与 include/target.mk 推出的
#   38 项一致（官方多 autocore / kmod-gpio-button-hotplug / kmod-leds-gpio / opkg）。
#   其中 default-settings-chn 会在首次开机改写 opkg 源并设好时区，见 README。
#   这 42 项合计再带入约 93 个包 / 12.25 MB，不在下面任何体积表的口径内。
#

#
# Target System / Subtarget / Device
#
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_MULTI_PROFILE=y
#
# 官方 release 是「一次编全部设备」的构建，我们要的是单设备，所以这里两个
# 「批量」开关都要显式定住（定义在 scripts/target-metadata.pl 生成的
# TARGET_MULTI_PROFILE 菜单段里）：
#   config TARGET_ALL_PROFILES      bool "Enable all profiles by default"                default BUILDBOT
#   config TARGET_PER_DEVICE_ROOTFS bool "Use a per-device root filesystem ..."          default BUILDBOT
# 我们的 BUILDBOT=n，两者默认都是 n。PER_DEVICE_ROOTFS 显式开 y，是为了保证
# 每台设备单独成镜像并附带自己的 profile 包；ALL_PROFILES 显式写 is not set，
# 是为了日后万一有人误开 BUILDBOT 时不会突然把 145 个设备一起编进来。
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_PER_DEVICE_ROOTFS=y
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_h3c_magic-nx30-pro-nmbm=y

#
# Version banner
#
# ── 为什么必须同时开 IMAGEOPT：VERSIONOPT 的 prompt 挂在它上面 ────────
# 版本菜单并不在主仓库的 config/ 目录里，而是由包元数据脚本生成：
#   scripts/package-metadata.pl 的 gen_package_config()：
#     print "menuconfig IMAGEOPT\n\tbool \"Image configuration\"\n\tdefault n\n";
#     print "source \"package/*/image-config.in\"\n";
#   ⇒ 生成的 tmp/.config-package.in 里先有 IMAGEOPT，再引入
#     package/base-files/image-config.in
#   package/base-files/image-config.in L153-154：
#     menuconfig VERSIONOPT
#       bool "Version configuration options" if IMAGEOPT   ← 关键
#       default n
#     if VERSIONOPT                                        ← L163
#       config VERSION_DIST / VERSION_NUMBER / VERSION_REPO / VERSION_FILENAMES
#     endif                                                ← L274
#
# kconfig 铁律：没有 prompt 的符号，.config 里写什么都不算数，
# make defconfig 会静默把它 reset 掉。IMAGEOPT 默认是 n，所以
# 「只写 CONFIG_VERSIONOPT=y」时它没有 prompt ⇒ 整组 VERSION_* 子项
# （它们在 if VERSIONOPT 块内）一并失去可见性、被丢弃。
# 后果：VERSION_NUMBER 的自定义值不生效，VERSION_REPO 回落到 tag 默认值，
# 编译日志里会出现「VERSION_REPO 与源码 tag 不匹配」的警告。
#
# 官方发布产物可印证：config.buildinfo 第 252 行有 CONFIG_IMAGEOPT=y，
# 紧接着才有 CONFIG_VERSIONOPT=y 与一整组 VERSION_*。
# ⇒ 顺序上 IMAGEOPT 必须先于 VERSIONOPT 出现，这里照此排列。
#
CONFIG_IMAGEOPT=y
#
# 只改「显示用」的版本号，不动 VERSION_REPO。
# opkg 源地址由 VERSION_REPO 拼接（见 include/feeds.mk：src/gz %d_core %U/...），
# 所以显式写死它，才能保证刷完之后 opkg update 指向真实存在的官方 24.10.6 仓库。
# 若把 VERSION_NUMBER 当成源路径用，会得到一个不存在的 24.10.6-nx30pro 目录。
#
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="ImmortalWrt"
CONFIG_VERSION_NUMBER="24.10.6-nx30pro"
CONFIG_VERSION_CODE=""
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/24.10.6"
CONFIG_VERSION_FILENAMES=y

#
# Build settings
#
# ── 为什么必须开 DEVEL：CCACHE 的 prompt 挂在 DEVEL 上 ────────────────
# config/Config-devel.in：
#   menuconfig DEVEL
#     config CCACHE
#       bool "Use ccache" if DEVEL     ← 只有 DEVEL=y 时这个符号才有 prompt
#     config BUILD_LOG
#       bool "Enable log files during build process" if DEVEL
# kconfig 里「没有 prompt 的符号」无法从 .config 赋值，会被 reset 成默认值。
# 所以 CONFIG_CCACHE=y 必须与 CONFIG_DEVEL=y 成对出现，否则 make defconfig
# 会静默把它丢掉，缓存失效而第二次编译仍要数小时。
#
# 注意：KERNEL_DEBUG_INFO 与 DEVEL **无关**。它的默认值来自
#   config/Config-kernel.in：
#     config KERNEL_DEBUG_INFO
#       bool "Compile the kernel with debug information"
#       default y if !SMALL_FLASH
# filogic 不属于 SMALL_FLASH，所以它的默认值本来就是 y —— 无论 DEVEL 开不开。
# 必须显式关掉，否则内核与全部模块都会带 DWARF 调试信息，镜像明显变大、
# 编译时间也显著拉长（CI 的磁盘和分钟数都耗不起）。
CONFIG_DEVEL=y
CONFIG_CCACHE=y
# CONFIG_BUILDBOT is not set
# CONFIG_BUILD_LOG is not set
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
# CONFIG_JSON_CYCLONEDX_SBOM is not set
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF_MODULES is not set
# ── 为什么这里没有 CONFIG_STRIP_KERNEL_EXPORTS ─────────────────────
# 它看起来很有吸引力（"剥掉内核里用不到的导出符号，减小体积"），但源码里它是：
#   config/Config-build.in L236-238：
#     config STRIP_KERNEL_EXPORTS
#       bool "Strip unnecessary exports from the kernel image"
#       depends on BROKEN            ← 关键
# BROKEN 又是 `bool "Show broken platforms / packages / devices" if DEVEL`，
# 默认 n。BROKEN=n 时这个符号没有 prompt，kconfig 对「无 prompt 的 bool」
# 的处理是**不写入 .config** —— 所以无论在这里写 =y 还是 is not set 都不会生效，
# make defconfig 之后它压根不会出现在 .config 里。
# 官方发布产物的 config.buildinfo 全篇也查无此行（我已逐行确认），双重印证。
# 收益本来也很小：它只影响 vmlinux 的 EXPORT_SYMBOL 表，而真正的大头
# 是 KERNEL_DEBUG_INFO（见下），那个才是必须关的。
# 若将来确实需要它，正确写法是先 CONFIG_DEVEL=y + CONFIG_BROKEN=y，
# 但那会一并打开一堆「实验性/已损坏」的目标与包，得不偿失。

#
# LuCI（默认只有 luci-light，这里补成完整版并中文化）
#
# ── 中文界面到底靠哪个开关（最容易写错的一处）───────────────────────
# luci 的汉化包是「按语言派生」出来的，机制在 feeds/luci/luci.mk：
#   1) luci-base 的 config 段里按语言生成一个**带 prompt** 的开关：
#        config LUCI_LANG_zh_Hans
#          tristate "Simplified Chinese (zh_Hans)"
#   2) LuciTranslation 为每个应用派生 luci-i18n-<应用>-zh-cn，并给它
#        HIDDEN:=1
#        DEFAULT:=LUCI_LANG_zh_Hans||(ALL&&m)
# 关键在 HIDDEN。scripts/package-metadata.pl 生成 kconfig 时对 hidden 包会
# 清空 prompt（`$pkg->{hidden} and $title = "";`），只留 default 交给 kconfig
# 求值 —— 也就是说这些 i18n 包**自身没有 prompt，取值由 LUCI_LANG_zh_Hans 驱动**。
# 所以下面写两层：CONFIG_LUCI_LANG_zh_Hans=y 是真正生效的总开关；逐包列出的
# 8 行是同一结果的显式表达（官方 config.buildinfo 也是这种逐包写法）。
# 实测：本方案选中的 LuCI 应用/模块里，存在 zh-cn 汉化包的恰好只有这 8 个
# （luci-mod-network / luci-mod-status / luci-mod-system / luci-theme-argon 等
# 都没有对应的 zh-cn 包），8 个包 Installed-Size 合计仅 270 KB。
# 因此开 LUCI_LANG_zh_Hans 不会带来任何额外体积或额外包。
#
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-i18n-argon-config-zh-cn=y

#
# 代理：PassWall
# 子选项依据锁定 feed 提交 adb3df4d 下的
# applications/luci-app-passwall/Makefile（PKG_VERSION 25.12.16）逐条核对。
#
# ── 实际会编进固件的代理核心（Installed-Size 实测）────────────────
#   xray-core                   26.41 MB  ← 主核心：vmess / vless / trojan / SS
#   hysteria                    17.15 MB  ← Hysteria2 客户端（apernet/hysteria 2.6.5）
#   shadowsocks-rust-sslocal     7.83 MB  ← SS 专用客户端，跑 SS 比 Xray 更省
#   v2ray-geoip + v2ray-geosite  24.05 MB  ← 内置 geo 数据，免首次联网下载
# 另有 16 个强制依赖包（合计 2.62 MB）由 LUCI_DEPENDS 强制拉入，不受下面
# 任何开关控制，其中最关键的是 chinadns-ng（DNS 分流引擎，510 KB）与
# dns2socks / ipt2socks / microsocks（转发与 DNS 通道）、curl（订阅拉取）、
# tcping（节点测速，决定页面上的 ping 值）。
#
# ── 关于 INCLUDE_Hysteria：包名叫 hysteria，装的就是 Hysteria2 ──────
# 不要被包名误导，这个包里没有 Hysteria1：
#   packages feed 源码：net/hysteria/Makefile
#     PKG_VERSION      := 2.6.5
#     PKG_SOURCE_URL   := codeload.github.com/apernet/hysteria/tar.gz/app/v2.6.5
#     GO_PKG_BUILD_PKG := github.com/apernet/hysteria/app/v2
# 即构建的是 apernet/hysteria 的 v2 分支 —— 也就是 Hysteria2。
# passwall 侧对应的节点类型名是 hysteria2（不是 hysteria），
# 配置由 luasrc/passwall/util_hysteria2.lua 生成，
# 二进制路径取自 uci 的 global_app.hysteria_file，默认 /usr/bin/hysteria。
# hysteria 包依赖仅 libc + ca-bundle，**不需要任何额外内核模块**。
#
# 它在 passwall 里支持三种本地转发方式（见 util_hysteria2.lua 的 gen_config）：
#   tcpRedirect  → redirect 模式，监听 tcpRedirect.listen
#   tcpTProxy    → tproxy 模式，监听 tcpTProxy.listen
#   udpTProxy    → UDP 转发，监听 udpTProxy.listen
# 并且 hysteria2 同时出现在 app.sh 的 REDIRECT_LIST 与 TPROXY_LIST 中，
# 两种透明代理模式都可用。UDP 转发走 nftables tproxy，
# 依赖的 kmod-nft-tproxy 已在下方内核模块区显式编入。
# 另支持：端口跳跃（hop）、salamander 混淆（obfs）、
# TLS pinSHA256、QUIC 窗口调优（recv_window / conn 窗口 / idle_timeout）、
# 带宽声明（up/down mbps）、多路复用惰性启动（lazy）。
#
# 体积代价：Installed-Size 17,560 KB，squashfs 压缩后约 5–6 MB。
# 内存代价：Go + 自有 QUIC 栈，常驻约 25–45 MB（与流量、并发连接数相关）。
#   15 台设备同时在线时会明显高于 Xray。若实测内存紧张，
#   优先考虑是否真的需要让全部设备同时跑 Hysteria2 节点。
#
# ── 关于 INCLUDE_V2ray_Geodata (24.05 MB) ────────────────────────
# 要分清它和 Geoview 是两回事：这个是真正的 geoip/geosite 数据（Xray 内部
# 路由的 geoip:cn / geosite:cn 标签用它），Geoview 只是查看这些数据的界面。
# 「大陆白名单」「GFWList」两种模式本身靠 passwall 自带的
# chnroute(65KB) / chnlist(1.4MB) / gfwlist(80KB) 即可运行，并不依赖它。
# 保留的理由：passwall 首次会尝试从 GitHub 拉取这些数据，而那一刻恰是
# 代理尚未配好、网络不通的时候 —— 内置可避开这个死循环。
# 若追求极简且确定只用规则列表分流，可改为 is not set（省 24 MB）。
#
# ── 关闭项合计排除 97.8 MB（Installed-Size 未压缩口径，共十项）──────
# 注意：这些开关在 aarch64 上大多「默认 y」，必须逐条显式 is not set，
# 否则 make defconfig 会把它们全部打开。各包体积取自官方 24.10.6
# aarch64_cortex-a53 包索引的 Installed-Size 字段：
#   SingBox 40.06 / Xray_Plugin 16.88 / V2ray_Plugin 14.44 / NaiveProxy 6.75 /
#   SS_Rust_Server 6.34 / Geoview 5.25 / Haproxy 3.21 / Shadow_TLS 3.02 /
#   tuic_client 1.70 / Simple_Obfs 0.14（单位 MB，十项合计 97.79 MB）
# （Hysteria 17.15 MB 原在此列，现已按需求改为编入，故不在此计；
#   若把它加回来，这张表就是 114.9 MB。）
# 关掉它们的首要理由是内存（Sing-Box 常驻远高于 Xray）与无用二进制。
#
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Hysteria=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client=y
CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geodata=y
# Geoview 只是一个「查看 geoip/geosite 数据」的界面，5509 KB，与代理功能无关 → 关
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Geoview is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Haproxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_NaiveProxy is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadow_TLS is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Simple_Obfs is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_SingBox is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_tuic_client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_V2ray_Plugin is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Xray_Plugin is not set
CONFIG_PACKAGE_luci-i18n-passwall-zh-cn=y

#
# VPN 组网：ZeroTier
# 包名与开关名取自锁定 feed 提交 97af1398 下的 net/zerotier/Makefile
# （PKG_VERSION 1.14.1）与 luci@adb3df4d 下的 applications/luci-app-zerotier。
#
# ── 体积代价很小：边际仅 3.47 MB ──────────────────────────────────
# 算法是「同一条闭包算法跑两遍再取差集」（root 分别为含 / 不含 zerotier 的
# 完整显式包清单），这样才不会把本来就有的依赖误算成新增：
#     不含 ZeroTier：164 个包 / 101.7 MB
#     含  ZeroTier：171 个包 / 105.2 MB
# （口径：这里是「显式包依赖闭包」，差集法必须同口径。它不含 target 的
#   Default-Packages 另带入的 93 个包 / 12.25 MB；真机装机集约 264 个 / 117.5 MB，
#   见 README 与方案报告第 05 节。）
# 真正新增 7 个包（Installed-Size 合计 3,550 KB）：
#   libstdcpp6                2,060 KB  ← C++ 运行时，ZeroTier 用 C++ 写成
#   zerotier                  1,250 KB  ← 主程序（含 zerotier-one / zerotier-cli）
#   libminiupnpc                 70 KB
#   libnatpmp1                   70 KB
#   libatomic1                   70 KB
#   luci-app-zerotier            20 KB
#   luci-i18n-zerotier-zh-cn     10 KB  ← 界面汉化，与其余应用保持一致
#
# 不额外占用的依赖：kmod-tun（已在内核模块区）、libpthread、libgcc1，
# 以及 ip-full 提供的虚拟包名 `ip` —— 连带 libnl-tiny1 72K、libbpf1 399K、
# libelf1 143K、zlib 143K、libmnl0 72K 也都早已在闭包内。
# 一个容易踩的坑：miniupnpd-nftables 的 Depends 是 libc / libcap-ng / libmnl0 /
# libuuid1 / libnftnl11，**不含** libminiupnpc 与 libnatpmp1 —— 所以这两个
# 确实是 ZeroTier 带进来的，不能想当然算作「UPnP 那里已经有了」。
#
# ── 依赖满足情况：不需要额外内核模块 ──────────────────────────────
# Makefile 的 DEPENDS 是：
#   +libpthread +libstdcpp +kmod-tun +ip +libminiupnpc +libnatpmp +libatomic
# 其中 kmod-tun 已在上方内核模块区显式编入 —— 这正是「内核模块必须此刻编入」
# 这条铁律发挥作用的地方：如果当初没预留 kmod-tun，现在就得整个重编固件。
#
# ── 与 firewall4 的兼容性：已核对，原生适配 ──────────────────────
# 本包自带 /usr/bin/zerotier-fw4（由 net/zerotier/files/usr/bin/ 提供），
# 内部直接用 nft 命令操作 fw4 表：
#   nft insert rule inet fw4 input|forward|srcnat ...
# 而 /etc/init.d/zerotier 调用它之后再执行 fw4 reload。
# 也就是说它走的是 nftables 路径，**不需要装 iptables-nft / iptables-legacy**。
# 这一点必须确认，因为 24.10 是 firewall4（nftables）环境，
# 若它按老办法调 iptables，UCI 里的 fw_allow_* 会静默失效。
#
# ── 两个子开关必须显式关闭 ────────────────────────────────────────
# net/zerotier/Config.in 定义了这两个符号，default 均为 n，但它们的符号名
# 不带 PACKAGE_ 前缀（CONFIG_ZEROTIER_ENABLE_*），容易在检查时漏掉。
CONFIG_PACKAGE_zerotier=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-i18n-zerotier-zh-cn=y
# CONFIG_ZEROTIER_ENABLE_DEBUG is not set
# CONFIG_ZEROTIER_ENABLE_SELFTEST is not set

#
# 内核模块：必须此刻编入（事后无法安装，见文件头说明）
# 以下 11 个的 Installed-Size 实测合计 550 KB，换来的是以后改需求时不用重编固件。
#
# ── passwall 运行必需 ──────────────────────────────────────────────
# 这三个是 luci-app-passwall 的强制依赖：写在 LUCI_DEPENDS 里，不受任何
# INCLUDE_ 开关控制，不写也会被依赖解析自动选中。此处显式写出，是为了让
# CI 自检能逐个断言 —— 缺任何一个，TProxy 透明代理直接不工作。
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-nat=y
#
# ── 预留余量（当下用不到，但内核侧无法事后补装）──────────────────
# 内核内置的模块：zram 与 zram-swap 配套
CONFIG_PACKAGE_kmod-zram=y
# NAT 全锥型：firewall4 已依赖它，显式写出以固定行为
CONFIG_PACKAGE_kmod-nft-fullcone=y
# BBR 拥塞控制：跨境高延迟线路的吞吐提升明显
CONFIG_PACKAGE_kmod-tcp-bbr=y
# TUN 虚拟网卡：TUN 模式的代理（sing-box / clash 内核）需要
CONFIG_PACKAGE_kmod-tun=y
# 连接追踪诊断：passwall 状态页按进程名匹配连接时用得到
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
# WireGuard：将来若要做异地组网 / 机场走 WG，省得重编
CONFIG_PACKAGE_kmod-wireguard=y
# CAKE 队列算法：将来给 15 台设备做延迟控制（SQM）时要
CONFIG_PACKAGE_kmod-sched-cake=y

#
# NAT 与网络
#
# UPnP 有两个后端变体：miniupnpd-iptables / miniupnpd-nftables。
# 24.10 用的是 firewall4（nftables），必须显式指定 nftables 变体。
# 不指定的话，LuCI 上装出来的是哪个后端取决于变体的默认优先级，容易踩坑。
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

#
# 内存与运维
#
# zram-swap：用压缩内存做交换区，比闪存交换快得多，也不磨损 NAND
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_htop=y
